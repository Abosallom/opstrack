<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>OpsTrack</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- The app ships a complete Arabic tree (src/locales/ar/*.json) with an RTL
	     layout, but localisation here is done in JS, not in .lproj bundles, so
	     iOS and the App Store would otherwise advertise English only. This key
	     is the declaration that makes the store listing say Arabic and lets iOS
	     hand the app an ar-* preferredLanguage on an Arabic device. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- DELIBERATELY NO NSAppTransportSecurity KEY.
	     Verified, not assumed: `nscurl --ats-diagnostics --verbose
	     https://lrysgpbkmuqgzsjesfkr.supabase.co` reports
	     "Default ATS Connection ... Result : PASS", i.e. the Supabase host
	     already satisfies ATS (TLS 1.2+, forward secrecy, SHA-256) with an
	     EMPTY ATS dictionary. Adding NSAllowsArbitraryLoads "to be safe" would
	     buy nothing and cost an App Review encryption-justification round.
	     Re-run that command before adding any exception here. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<!-- false: the only cryptography is HTTPS/TLS provided by the OS, which is
	     exempt under the standard-encryption clause. Without this key App Store
	     Connect blocks EVERY build behind the export-compliance questionnaire. -->
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<!-- arm64, not the Capacitor template's armv7: armv7 is the 32-bit
		     instruction set, and IPHONEOS_DEPLOYMENT_TARGET is 15.0 — every
		     device that can install this app is 64-bit. Leaving armv7 here
		     states a requirement no supported device advertises. -->
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
